---
import Base from "../../layouts/Base.astro";
import {
  getPublications,
  byYear,
  getSelected,
  describe,
} from "../../lib/publications";
import { site } from "../../data/site";

const all = getPublications();
const selected = getSelected(all);
const years = byYear(all);
---

<Base title="Publications" description="Publications by Ben Dichter.">
  <h1>Publications</h1>

  <p>
    Generated from my <a href={`https://orcid.org/${site.orcid}`}>ORCID record</a> at
    build time. Also on{" "}
    <a href="https://scholar.google.com/citations?user=_IwI_oEAAAAJ">Google Scholar</a>.
  </p>

  <h2>Selected</h2>
  <ul class="entries">
    {
      selected.map((pub) => (
        <li>
          {pub.url ? (
            <a class="entry__title" href={pub.url}>
              {pub.title}
            </a>
          ) : (
            <span class="entry__title">{pub.title}</span>
          )}
          <div class="entry__meta">
            <em>{describe(pub)}</em>
            {pub.year && <> &middot; {pub.year}</>}
          </div>
        </li>
      ))
    }
  </ul>

  <h2>All publications</h2>

  {
    years.map(([year, pubs]) => (
      <section>
        {/* h3, not h2: these sit under "All publications" rather than beside
            it. The .year class carries the look either way. */}
        <h3 class="year">{year || "Undated"}</h3>
        <ul class="entries">
          {pubs.map((pub) => (
            <li>
              {pub.url ? (
                <a class="entry__title" href={pub.url}>
                  {pub.title}
                </a>
              ) : (
                <span class="entry__title">{pub.title}</span>
              )}
              <div class="entry__meta">
                <em>{describe(pub)}</em>
                {pub.doi && <> &middot; {pub.doi}</>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
