---
import Base from "../layouts/Base.astro";
import { nav } from "../data/site";

const blurbs: Record<string, string> = {
  Software: "Side projects, apps, and libraries.",
  Publications: "Papers, from 2014 onward.",
  Talks: "Recorded talks and workshop sessions.",
  Blog: "Write-ups of things I have built.",
};
---

<Base title="Page Not Found" noindex>
  {/* The spectrum runs unbroken across the top of every other page. Here it is
      in pieces, which is the one thing this page has to say. */}
  <div class="broken" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span><span></span>
  </div>

  <h1>Page not found</h1>

  <p class="lede">
    There is nothing at this address. It may have moved when I rebuilt the site,
    or it may never have existed.
  </p>

  <p>Everything here is one of these:</p>

  <ul class="entries">
    <li>
      <a class="entry__title" href="/">About me</a>
      <div class="entry__meta">Who I am and what I work on.</div>
    </li>
    {
      nav.map((item) => (
        <li>
          <a class="entry__title" href={item.href}>
            {item.title}
          </a>
          <div class="entry__meta">{blurbs[item.title]}</div>
        </li>
      ))
    }
  </ul>

  <p>
    If a link on this site sent you here, I would like to fix it. Let me know at{" "}
    <a href="mailto:ben.dichter@catalystneuro.com">ben.dichter@catalystneuro.com</a>.
  </p>
</Base>

<style>
  .broken {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.75rem;
  }

  .broken span {
    height: 3px;
    border-radius: 2px;
  }

  /* Uneven widths, so it reads as a line that came apart rather than as a row
     of tidy dashes. */
  .broken span:nth-child(1) {
    width: 3.5rem;
    background: var(--c1);
  }
  .broken span:nth-child(2) {
    width: 1.25rem;
    background: var(--c2);
  }
  .broken span:nth-child(3) {
    width: 2.75rem;
    background: var(--c3);
  }
  .broken span:nth-child(4) {
    width: 0.75rem;
    background: var(--c4);
  }
  .broken span:nth-child(5) {
    width: 2rem;
    background: var(--c5);
  }
  .broken span:nth-child(6) {
    width: 1rem;
    background: var(--c6);
  }
</style>
