---
import Base from "../../layouts/Base.astro";
import { getPosts, groupByYear, formatDate } from "../../lib/content";

const years = groupByYear(await getPosts());
---

<Base
  title="Blog"
  description="Side projects and notes from Ben Dichter, outside of his CatalystNeuro work."
>
  <h1>Blog</h1>

  <p class="lede">
    This is where I write up side projects, the things I build outside of work. It is
    not a good picture of where most of my time goes. The bulk of my development effort
    is CatalystNeuro work, and that is where you should look for it:{" "}
    <a href="https://catalystneuro.com">catalystneuro.com</a>.
  </p>

  {
    years.map(([year, posts]) => (
      <section>
        <h2 class="year">{year}</h2>
        <ul class="entries">
          {posts.map((post) => (
            <li>
              <a class="entry__title" href={post.data.permalink}>
                {post.data.title}
              </a>
              <div class="entry__meta">{formatDate(post.data.date)}</div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
