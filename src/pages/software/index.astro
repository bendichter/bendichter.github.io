---
import Base from "../../layouts/Base.astro";
import { projects } from "../../data/site";

const apps = projects.filter((p) => p.kind === "app");
const tools = projects.filter((p) => p.kind === "tool");

const groups = [
  {
    title: "Apps",
    blurb: "Things with a front door, that someone other than me uses.",
    items: apps,
  },
  {
    title: "Libraries and tools",
    blurb: "Smaller pieces, mostly Python, mostly written to scratch an itch.",
    items: tools,
  },
];
---

<Base
  title="Software"
  description="Side projects by Ben Dichter: apps, libraries, and tools built outside of his CatalystNeuro work."
  sidebar={false}
>
  <div class="wide">
    <h1>Software</h1>

    <p class="lede">
      Side projects, the things I build outside of work. My neuroscience software is
      CatalystNeuro's and lives at{" "}
      <a href="https://catalystneuro.com">catalystneuro.com</a>.
    </p>

    {
      groups.map((group) => (
        <section>
          <h2>{group.title}</h2>
          <p class="group__blurb">{group.blurb}</p>
          <ul class="cards">
            {group.items.map((project) => (
              <li class="card">
                <div class="card__head">
                  <h3 class="card__name">
                    <a href={project.href}>{project.name}</a>
                  </h3>
                  {project.stars && (
                    <span class="card__stars" title={`${project.stars} stars on GitHub`}>
                      ★ {project.stars}
                    </span>
                  )}
                </div>

                <span class="card__lang">{project.lang}</span>

                <p class="card__blurb">{project.blurb}</p>

                {project.facts && (
                  <ul class="card__facts">
                    {project.facts.map((fact) => (
                      <li>{fact}</li>
                    ))}
                  </ul>
                )}

                <div class="card__links">
                  {!project.href.includes("github.com") && (
                    <a href={project.href}>Visit &rarr;</a>
                  )}
                  {project.repo && <a href={project.repo}>Source</a>}
                </div>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
