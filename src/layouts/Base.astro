---
import "../styles/global.css";
import { site, nav, socials } from "../data/site";
import Profile from "../components/Profile.astro";
import Icon from "../components/Icon.astro";
import StructuredData from "../components/StructuredData.astro";

interface Props {
  title?: string;
  description?: string;
  /**
   * The profile column is the homepage's, and only the homepage's. Every other
   * page runs full width: repeating the avatar and bio above a list of talks
   * tells a reader nothing they did not learn on the way in, and it forced the
   * card grids into a column too narrow for them. The social links live in the
   * footer instead, so they are still reachable from everywhere.
   */
  sidebar?: boolean;
  /** Emits BlogPosting structured data instead of WebSite. */
  article?: { published: Date };
  /** Keeps thin archive pages out of the index. */
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  sidebar = false,
  article,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} - ${site.title}` : site.title;
const canonical = new URL(Astro.url.pathname, site.url);
const ogImage = new URL(site.avatar, site.url);
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <StructuredData
      type={article ? "article" : "website"}
      title={title}
      description={description}
      published={article?.published}
    />

    {/* One block, always emitted. The Jekyll theme only set og:image when a
        page declared a header image, and used a relative path when it did. */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />

    {/* Generated from images/profile.jpeg by scripts/make-icons.mjs. Kept to
        the four declarations that modern browsers actually read, rather than
        the eighteen the Jekyll theme emitted for files that never existed. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/images/favicon-96x96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon-180x180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="shell">
        <a class="masthead__name" href="/">{site.title}</a>
        <nav aria-label="Main">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={path.startsWith(item.href) ? "page" : undefined}
              >
                {item.title}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <div class:list={["shell", "layout", !sidebar && "layout--solo"]}>
      {sidebar && <Profile />}
      <main id="main">
        <slot />
      </main>
    </div>

    <footer class="footer">
      <div class="shell">
        <ul class="footer__links">
          {
            socials.map((s) => (
              <li>
                <a href={s.href} rel={s.href.startsWith("http") ? "me" : undefined}>
                  <Icon name={s.icon} />
                  {s.title}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="footer__legal">
          &copy; {new Date().getFullYear()} {site.name}. <a href="/terms/">Privacy</a>.{" "}
          <a href="/rss.xml">RSS</a>. Built with <a href="https://astro.build">Astro</a>.
        </p>
      </div>
    </footer>
  </body>
</html>
