---
import { site, socials } from "../data/site";
import Icon from "./Icon.astro";
---

<aside class="profile">
  {/* The JPEG stays the canonical file (it is the source for every icon and the
      fallback og:image); the WebP beside it is what the page actually loads. */}
  <picture>
    <source srcset="/images/profile-240.webp" type="image/webp" />
    <img
      class="profile__avatar"
      src={site.avatar}
      width="272"
      height="272"
      alt="Ben Dichter"
    />
  </picture>
  <div class="profile__name">{site.name}</div>
  <p class="profile__bio">
    Research Software Engineer and Founder of{" "}
    <a href="https://catalystneuro.com">CatalystNeuro</a>.
  </p>
  <ul class="profile__links">
    {
      socials.map((s) => (
        <li>
          <a
            href={s.href}
            rel={s.href.startsWith("http") ? "me" : undefined}
            aria-label={s.title}
          >
            <Icon name={s.icon} />
            <span>{s.title}</span>
          </a>
        </li>
      ))
    }
  </ul>
</aside>
