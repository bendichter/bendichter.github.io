---
import { authorParts, type Publication } from "../lib/publications";

/** One line of authors under a publication title, with my name picked out. */
interface Props {
  pub: Publication;
}

const { pub } = Astro.props;
const parts = authorParts(pub);
const total = pub.authors?.length ?? 0;
const cut = parts.some((p) => "gap" in p);
---

<div class="entry__authors">
  {
    parts.map((p, i) => (
      <>
        {i > 0 && ", "}
        {"gap" in p ? (
          <>
            <span aria-hidden="true">…</span>
            <span class="visually-hidden">and others</span>
          </>
        ) : p.me ? (
          <span class="entry__me">{p.name}</span>
        ) : (
          p.name
        )}
      </>
    ))
  }
  {cut && <span class="entry__count"> ({total} authors)</span>}
</div>
